    "@cad-studio/tool-runtime": "workspace:*",
    "@cad-studio/viewport": "workspace:*",
    "@cad-studio/viewport-runtime": "workspace:*",
    "@tauri-apps/api": "^2.5.0",
    "@tauri-apps/plugin-dialog": "^2.2.0",
